{
  "name": "nexora-video-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node validate.js",
    "preprocess": "node preprocess.js",
    "generate": "node generate.js",
    "generate:force": "node generate.js --force",
    "check": "node render-all.js check",
    "render": "node render-all.js render",
    "render:range": "node render-all.js render --from 1 --to 5",
    "retry": "node render-all.js retry-failed",
    "status": "node render-all.js status",
    "qc": "node render-all.js qc",
    "dashboard": "start dashboard.html",
    "all": "node validate.js && node preprocess.js && node generate.js && node render-all.js render",
    "pipeline": "node validate.js && node generate.js && node render-all.js render"
  }
}
